#!/usr/bin/env bash
# Interactive Cloudflare Tunnel launcher using gum.
# Scans ~/.cloudflared/ for config files and lets you pick one.

set -euo pipefail

CONFIG_DIR="$HOME/.cloudflared"

usage() {
  cat <<'EOF'
Usage: tunnel [command] [args]

Interactive Cloudflare Tunnel manager.

Commands:
  (none)                 Pick a tunnel config and run it
  create <hostname>      Create a new tunnel + DNS route + config
                         (e.g. tunnel create intercom.dottt.app)
  delete [name]          Delete a tunnel, its config file, and credentials.
                         Prompts with a picker if no name is given.
  -h, --help             Show this help

Config files live in ~/.cloudflared/*config*.yml
EOF
}

# ── Subcommand: help ──────────────────────────────────────────────────
case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
esac

# ── Subcommand: create ────────────────────────────────────────────────
if [ "${1:-}" = "create" ]; then
  shift
  HOSTNAME="${1:?Usage: tunnel create <hostname>  (e.g. intercom.dottt.app). See tunnel --help}"

  # Derive a tunnel name from the first subdomain segment
  TUNNEL_NAME="${HOSTNAME%%.*}"

  if ! command -v gum &>/dev/null; then
    echo "Error: gum is not installed. Install with: brew install gum"
    exit 1
  fi
  if ! command -v cloudflared &>/dev/null; then
    echo "Error: cloudflared is not installed. Install with: brew install cloudflared"
    exit 1
  fi

  # Ask for the local port to forward to
  PORT=$(gum input --placeholder "Local port (e.g. 3000)" --header "Which local port should $HOSTNAME route to?")
  if [ -z "$PORT" ]; then
    gum style --foreground 9 --bold "No port provided. Aborting."
    exit 1
  fi

  echo
  gum style --foreground 212 --bold --border rounded --border-foreground 99 --padding "0 2" "Create Cloudflare Tunnel"
  echo
  gum style --foreground 245 "  Name:      $TUNNEL_NAME"
  gum style --foreground 245 "  Hostname:  $HOSTNAME"
  gum style --foreground 245 "  Service:   http://localhost:$PORT"
  echo

  gum confirm "Proceed?" || { echo "Aborted."; exit 1; }

  echo
  gum style --foreground 245 "Creating tunnel…"
  OUTPUT=$(cloudflared tunnel create "$TUNNEL_NAME" 2>&1)
  echo "$OUTPUT"

  # Extract the tunnel UUID from the creation output
  TUNNEL_ID=$(echo "$OUTPUT" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | head -1)
  if [ -z "$TUNNEL_ID" ]; then
    gum style --foreground 9 --bold "Failed to extract tunnel ID."
    exit 1
  fi

  gum style --foreground 10 "  Tunnel ID: $TUNNEL_ID"
  echo

  gum style --foreground 245 "Setting up DNS route…"
  cloudflared tunnel route dns -f "$TUNNEL_NAME" "$HOSTNAME"
  gum style --foreground 10 "  DNS CNAME created for $HOSTNAME"
  echo

  # Write config file
  if [ "$TUNNEL_NAME" = "dev" ] || [ "$TUNNEL_NAME" = "default" ]; then
    CONFIG_FILE="$CONFIG_DIR/config.yml"
  else
    CONFIG_FILE="$CONFIG_DIR/${TUNNEL_NAME}-config.yml"
  fi

  cat > "$CONFIG_FILE" <<EOF
tunnel: $TUNNEL_ID
credentials-file: $CONFIG_DIR/${TUNNEL_ID}.json

ingress:
  - hostname: $HOSTNAME
    service: http://localhost:$PORT
  - service: http_status:404
EOF

  gum style --foreground 10 "  Config written to $(basename "$CONFIG_FILE")"
  echo
  gum style --foreground 212 --bold "Done! Run 'tunnel' to start it."
  exit 0
fi

# ── Subcommand: delete ────────────────────────────────────────────────
if [ "${1:-}" = "delete" ]; then
  shift

  if ! command -v gum &>/dev/null; then
    echo "Error: gum is not installed. Install with: brew install gum"
    exit 1
  fi
  if ! command -v cloudflared &>/dev/null; then
    echo "Error: cloudflared is not installed. Install with: brew install cloudflared"
    exit 1
  fi
  if ! command -v jq &>/dev/null; then
    echo "Error: jq is not installed. Install with: brew install jq"
    exit 1
  fi

  TUNNEL_LIST=$(cloudflared tunnel list --output json 2>/dev/null)

  TUNNEL_NAME="${1:-}"

  if [ -z "$TUNNEL_NAME" ]; then
    # Interactive picker from existing tunnels
    tunnels=()
    while IFS= read -r name; do
      [ -n "$name" ] && tunnels+=("$name")
    done < <(echo "$TUNNEL_LIST" | jq -r '.[].name' | sort -u)
    if [ ${#tunnels[@]} -eq 0 ]; then
      gum style --foreground 9 --bold "No tunnels found."
      exit 1
    fi
    TUNNEL_NAME=$(printf '%s\n' "${tunnels[@]}" | gum choose --header "Select a tunnel to delete:" --cursor.foreground 212)
    [ -n "$TUNNEL_NAME" ] || { echo "Aborted."; exit 1; }
  fi

  # Look up tunnel ID
  TUNNEL_ID=$(echo "$TUNNEL_LIST" | jq -r --arg name "$TUNNEL_NAME" '.[] | select(.name == $name) | .id' | head -1)

  # Extract hostname(s) from matching configs (for the DNS cleanup heads-up)
  hostnames=()

  # Find matching config file(s)
  matched_configs=()
  for f in "$CONFIG_DIR"/*config*.yml "$CONFIG_DIR"/*config*.yaml; do
    [ -f "$f" ] || continue
    if [ -n "$TUNNEL_ID" ] && grep -q "$TUNNEL_ID" "$f"; then
      matched_configs+=("$f")
    elif [ "$(basename "$f")" = "${TUNNEL_NAME}-config.yml" ]; then
      matched_configs+=("$f")
    fi
  done

  for f in "${matched_configs[@]:-}"; do
    [ -n "$f" ] || continue
    while IFS= read -r h; do
      [ -n "$h" ] && hostnames+=("$h")
    done < <(grep 'hostname:' "$f" | awk '{print $3}')
  done

  echo
  gum style --foreground 212 --bold --border rounded --border-foreground 99 --padding "0 2" "Delete Cloudflare Tunnel"
  echo
  gum style --foreground 245 "  Name:      $TUNNEL_NAME"
  [ -n "$TUNNEL_ID" ] && gum style --foreground 245 "  Tunnel ID: $TUNNEL_ID"
  for f in "${matched_configs[@]:-}"; do
    [ -n "$f" ] && gum style --foreground 245 "  Config:    $(basename "$f")"
  done
  echo

  gum confirm "Delete this tunnel? This cannot be undone." || { echo "Aborted."; exit 1; }

  echo
  gum style --foreground 245 "Deleting tunnel…"
  cloudflared tunnel delete -f "$TUNNEL_NAME"
  gum style --foreground 10 "  Tunnel deleted."

  # Remove credentials file
  if [ -n "$TUNNEL_ID" ] && [ -f "$CONFIG_DIR/${TUNNEL_ID}.json" ]; then
    rm -f "$CONFIG_DIR/${TUNNEL_ID}.json"
    gum style --foreground 10 "  Removed credentials ${TUNNEL_ID}.json"
  fi

  # Remove config file(s)
  for f in "${matched_configs[@]:-}"; do
    [ -n "$f" ] || continue
    rm -f "$f"
    gum style --foreground 10 "  Removed config $(basename "$f")"
  done

  # Heads-up: DNS records can't be removed via cloudflared, clean up in the UI
  echo
  if [ ${#hostnames[@]} -gt 0 ]; then
    gum style --foreground 214 --bold "Heads up: DNS CNAME(s) still exist for: ${hostnames[*]}"
  else
    gum style --foreground 214 --bold "Heads up: any DNS CNAME for this tunnel still exists."
  fi
  gum style --foreground 214 "Delete them in the Cloudflare dashboard → DNS → Records:"
  gum style --foreground 214 "  https://dash.cloudflare.com"
  exit 0
fi

# ── Subcommand: run (default) ────────────────────────────────────────
if ! command -v gum &>/dev/null; then
  echo "Error: gum is not installed. Install with: brew install gum"
  exit 1
fi

if ! command -v cloudflared &>/dev/null; then
  echo "Error: cloudflared is not installed. Install with: brew install cloudflared"
  exit 1
fi

# Find all config files
configs=()
labels=()

for f in "$CONFIG_DIR"/*config*.yml "$CONFIG_DIR"/*config*.yaml; do
  [ -f "$f" ] || continue
  configs+=("$f")

  # Extract tunnel name/hostname for display
  hostname=$(grep -m1 'hostname:' "$f" | head -1 | awk '{print $3}' || echo "")
  tunnel_id=$(grep -m1 'tunnel:' "$f" | awk '{print $2}' || echo "")
  basename=$(basename "$f")

  if [ -n "$hostname" ]; then
    labels+=("$basename  →  $hostname")
  else
    labels+=("$basename  (tunnel: ${tunnel_id:0:8}…)")
  fi
done

if [ ${#configs[@]} -eq 0 ]; then
  gum style --foreground 9 --bold "No config files found in $CONFIG_DIR"
  exit 1
fi

if [ ${#configs[@]} -eq 1 ]; then
  selected="${configs[0]}"
  gum style --foreground 14 "Only one config found, using: $(basename "$selected")"
else
  # Build the gum choose input
  choice=$(printf '%s\n' "${labels[@]}" | gum choose --header "Select a tunnel:" --cursor.foreground 212)

  # Map selection back to config file
  for i in "${!labels[@]}"; do
    if [ "${labels[$i]}" = "$choice" ]; then
      selected="${configs[$i]}"
      break
    fi
  done
fi

if [ -z "${selected:-}" ]; then
  gum style --foreground 9 --bold "No tunnel selected."
  exit 1
fi

# Show what we're launching
echo
gum style --foreground 212 --bold --border rounded --border-foreground 99 --padding "0 2" "Cloudflare Tunnel"
echo
gum style --foreground 245 "  Config:  $(basename "$selected")"

# Show all hostnames from the config
grep 'hostname:' "$selected" 2>/dev/null | while read -r line; do
  host=$(echo "$line" | awk '{print $3}')
  service=$(grep -A1 "hostname: $host" "$selected" | grep 'service:' | awk '{print $2}')
  gum style --foreground 10 "  Route:   $host → ${service:-unknown}"
done

echo
gum style --foreground 245 "Starting tunnel…"
echo

exec cloudflared tunnel --config "$selected" run
